rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /test/{id} {
      allow read: if true;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    match /income_records/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    match /loyalty_profiles/{profileId} {
      allow read: if true;
      allow write: if isValidId(profileId);
    }

    match /lab_sync/{syncDocId} {
      allow read: if true;
      allow write: if isValidId(syncDocId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
